# Copy to .env and fill in. .env is loaded by scan.py (never committed).
OPENROUTER_API_KEY=sk-or-v1-...

# OpenRouter model slug for summaries. Default: z-ai/glm-5.2
# If OpenRouter returns "model not found", check the exact slug at
# https://openrouter.ai/models and override here.
#OPENROUTER_MODEL=z-ai/glm-5.2
