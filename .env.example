# Copy to `.env` and fill in. NEVER commit the real .env.

# --- Auth (gates the ENTIRE app) ---
# APP_PASSWORD is the single shared login password. REQUIRED — the server
# refuses to start without it (fail closed), so it can never deploy open.
APP_PASSWORD=
# SECRET_KEY signs the session cookie. Generate one, e.g.:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# If left blank, a random key is generated per process (you'll be logged out
# on every restart). Set it in production to stay logged in across deploys.
SECRET_KEY=
# Set COOKIE_SECURE=1 in production (HTTPS) so the session cookie is Secure.
# Leave blank for local http development, or the browser won't send the cookie.
COOKIE_SECURE=

# --- screener.in announcements scanner ---
# Session Cookie header from a logged-in screener.in browser session. Powers the
# Announcements page. In cloud, set it as a Fly secret (SCREENER_COOKIE); locally
# it falls back to screener_alerts/cookie.txt. Session cookies expire — refresh
# it when Announcements start failing with a "redirected to login" error.
# SCREENER_COOKIE=

# --- Telegram bot ---
# Token from @BotFather; chat ID from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- OpenRouter (news/IR scanner + voice research module) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.2

# --- Deploy / state ---
# DATA_DIR: where mutable state (watchlist.json, alert_log.json, research/) is
# written. Defaults to the repo dir locally; set to the mounted volume in cloud
# (Fly sets DATA_DIR=/data via fly.toml). PORT overrides the 8088 listen port.
# DATA_DIR=/data
# PORT=8088

# --- AWS / S3 voice context. In cloud prefer an IAM role over static keys. ---
# Set VOICE_S3_BUCKET to make voice read <SYMBOL>/*.txt filings from S3 (the
# scraper microservice populates it). Unset => voice uses local CONTEXT_DIRS.
# VOICE_S3_BUCKET=simrat-company-docs
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Scraper microservice (voice "Fetch filings" form) ---
# SCRAPER_URL: base URL of the deployed scraper app (scraper_service/), e.g.
# https://stock-scraper.fly.dev. SCRAPER_TOKEN: shared bearer token — set the
# SAME value here and as the scraper app's SCRAPER_TOKEN secret. Both empty =>
# the "Fetch filings" form is disabled and /api/scrape returns 503.
# SCRAPER_URL=
# SCRAPER_TOKEN=
