# Secrets must never enter the image (build args / env vars supply them at runtime)
.env
.env.*
screener_alerts/cookie.txt
*.pem
*.key

# Runtime state lives on a mounted volume, not baked in
alert_log.json
research/
uploads/
news_alerts/news_store.json
news_alerts/data/names_cache.json
screener_alerts/announcements_store.json
screener_alerts/annual_reports_seen.json
screener_alerts/seen.json
screener_alerts/pending.json

# Generated report/log artifacts (append-only, multi-MB)
news_alerts/reports.md
news_alerts/reports2.md
news_alerts/logs/
screener_alerts/digest.md
screener_alerts/annual_reports_digest.md
*.log

# One-off dev tools — not needed at runtime
merge_watchlists.py
news_alerts/discover_ir_feeds.py

# Duplicate/staging tree
.fixed-staging/

# Dev-only cruft
.git/
.gitignore
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.DS_Store
.claude/
HANDOFF.md
